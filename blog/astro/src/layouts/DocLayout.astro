---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TOC from '../components/TOC.astro';
import type { NavSection } from '../lib/nav';
import { buildBreadcrumb, flattenNav, getPrevNext } from '../lib/nav';
import { extractDescription } from '../lib/description';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  body: string;
  headings: Heading[];
  url: string;
  nav: NavSection[];
  created?: Date;
  modified?: Date;
  tags?: string[];
  author?: string;
}

const {
  title,
  description,
  ogImage,
  body,
  headings,
  url,
  nav,
  created,
  modified,
  tags = [],
  author = 'Chandra179',
} = Astro.props;

const siteName = 'Chan179';
const breadcrumb = buildBreadcrumb(nav, url);
const pageTitle = title || breadcrumb;
const pageDescription = description || extractDescription(body);
const baseDescription = 'Personal blog on software engineering, system design, and mathematics.';
const metaDescription = pageDescription || `Notes on ${breadcrumb}. ${baseDescription}`;

const wordCount = body ? body.split(/\s+/).filter(Boolean).length : 0;

const resolvedOgImage = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL('/og-image.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: metaDescription,
  wordCount,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(url, Astro.site).href,
  },
  ...(created && { datePublished: created.toISOString() }),
  ...((modified || created) && { dateModified: (modified || created)!.toISOString() }),
  author: { '@type': 'Person', name: author, '@id': new URL('/', Astro.site).href + '#author' },
  publisher: { '@type': 'Organization', name: siteName, '@id': new URL('/', Astro.site).href + '#publisher' },
  ...(ogImage && { image: resolvedOgImage }),
};

const crumbs = breadcrumb.split(' / ');
const pathParts = url.replace(/^\//, '').replace(/\/$/, '').split('/');
const crumbNames = ['Home', ...crumbs];
const crumbUrls: string[] = ['/'];
let accum = '';
for (let i = 0; i < crumbs.length; i++) {
  accum += (i === 0 ? '' : '/') + (pathParts[i] || crumbs[i].toLowerCase());
  crumbUrls.push('/' + accum);
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbNames.map((name, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name,
    item: i < crumbNames.length - 1
      ? new URL(crumbUrls[i], Astro.site).href
      : undefined,
  })),
};

const flat = flattenNav(nav);
const { prev, next } = getPrevNext(flat, url);
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  canonical={url}
  ogType="article"
  ogImage={resolvedOgImage}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
  created={created}
  modified={modified}
  tags={tags}
  author={author}
>
  <Sidebar nav={nav} currentPath={url} />

  <main class="min-h-screen bg-white dark:bg-gray-900 overflow-x-hidden transition-all duration-300 pt-16 lg:ml-64 xl:mr-64">
    <div class="mx-auto px-4 sm:px-6 py-8 lg:py-12 max-w-3xl">
      <div class="flex justify-between items-center mb-6 gap-4">
        <nav aria-label="Breadcrumb" class="text-sm">
          <ol class="flex flex-wrap items-center gap-1 text-gray-400 dark:text-gray-500">
            {crumbNames.map((name, i) => (
              <li class="flex items-center gap-1">
                {i < crumbNames.length - 1 ? (
                  <a href={crumbUrls[i]} class="hover:text-gray-700 dark:hover:text-gray-300 transition-colors">{name}</a>
                ) : (
                  <span class="text-gray-700 dark:text-gray-300 font-medium">{name}</span>
                )}
                {i < crumbNames.length - 1 && (
                  <svg class="w-3 h-3 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                )}
              </li>
            ))}
          </ol>
        </nav>
        {body && (
          <div
            x-data={`{ copied: false, body: ${JSON.stringify(body)}, async copy() { await navigator.clipboard.writeText(this.body); this.copied = true; setTimeout(() => this.copied = false, 2000); }, async downloadPdf() { await window.downloadPdf(); } }`}
            class="shrink-0 flex items-center gap-2 pdf-hide"
          >
            <button
              @click="copy"
              aria-label="Copy as Markdown"
              class="p-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors text-gray-500 dark:text-gray-400"
            >
              <svg x-show="!copied" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg x-show="copied" class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
            <button
              @click="downloadPdf"
              aria-label="Download as PDF"
              class="p-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors text-gray-500 dark:text-gray-400"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <path d="M12 18V12"></path>
                <path d="M9 15l3 3 3-3"></path>
              </svg>
            </button>
          </div>
        )}
      </div>

      <article id="content" class="prose prose-lg prose-blue max-w-none">
        <slot />
      </article>

      {(prev || next) && (
        <nav aria-label="Previous and next articles" class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
          <div class="grid grid-cols-2 gap-4">
            {prev ? (
              <a href={prev.url} class="group p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-600 transition-colors">
                <span class="text-xs text-gray-400 dark:text-gray-500">Previous</span>
                <span class="block mt-1 text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{prev.name}</span>
              </a>
            ) : <div></div>}
            {next ? (
              <a href={next.url} class="group p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-600 transition-colors text-right">
                <span class="text-xs text-gray-400 dark:text-gray-500">Next</span>
                <span class="block mt-1 text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{next.name}</span>
              </a>
            ) : <div></div>}
          </div>
        </nav>
      )}
    </div>
  </main>

  <TOC headings={headings} />

  <script>
    async function downloadPdf() {
      const heading = document.querySelector('#content h1');
      const title = heading?.textContent?.trim() || document.title?.trim() || 'document';
      const slug = window.location.pathname.replace(/^\/+/, '').replace(/\/+$/, '') || 'index';
      const params = new URLSearchParams({ slug, title });

      try {
        const res = await fetch(`/api/pdf?${params.toString()}`);
        if (res.status === 404) {
          // Dev mode: Worker is not running, fall back to browser print
          window.print();
          return;
        }
        if (!res.ok) {
          throw new Error(`PDF generation failed: ${res.status}`);
        }
        const blob = await res.blob();
        const match = res.headers.get('Content-Disposition')?.match(/filename="?([^"]+)"?/);
        const filename = match?.[1] || `${slug}.pdf`;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      } catch (err) {
        console.error('Download PDF failed:', err);
        alert('Failed to generate PDF. Please try again.');
      }
    }
    (window as any).downloadPdf = downloadPdf;
  </script>
</BaseLayout>
