---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getValidEntries } from '../lib/entries';
import { entryIdToUrl, deriveTitle } from '../lib/nav';
import { extractDescription } from '../lib/description';

const validEntries = await getValidEntries();

// Sort entries by created date (newest first)
const posts = validEntries
  .filter((e) => !e.data.noindex && e.id.toLowerCase() !== 'readme')
  .map((e) => {
    const slug = e.id.split('/').pop() || e.id;
    const title = e.data.title || deriveTitle(slug, e.data.title);
    const url = entryIdToUrl(e.id);
    const date = e.data.created ? new Date(e.data.created) : undefined;
    const formattedDate = date
      ? `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`
      : '';
    const tag = e.data.tags && e.data.tags.length > 0 ? e.data.tags[0] : 'note';
    const wordCount = e.body ? e.body.split(/\s+/).filter(Boolean).length : 0;
    const readTime = Math.max(1, Math.round(wordCount / 200)) + ' min read';

    return {
      title,
      url,
      date,
      formattedDate,
      tag,
      readTime,
      description: e.data.description || extractDescription(e.body),
    };
  })
  .sort((a, b) => {
    const aTime = a.date ? a.date.getTime() : 0;
    const bTime = b.date ? b.date.getTime() : 0;
    return bTime - aTime;
  });

const projects = [
  {
    title: 'Atlas Telemetry Canvas',
    description: 'High-throughput terminal rendering pipeline built with WebGPU and Go WebAssembly. Zero-overhead frame streaming for real-time cluster observability.',
    type: 'video',
    tag: '● VIDEO DEMO',
    tagColor: 'text-red-400 bg-red-500/20 border-red-500/30',
    tech: ['Go', 'WebAssembly', 'WebGPU', 'Video/MP4'],
    demoUrl: 'https://github.com/Chandra179/atlas',
    githubUrl: 'https://github.com/Chandra179/atlas',
    previewSnippet: 'atlas-engine --stream --fps 60',
  },
  {
    title: 'Synapse Node Mesh',
    description: 'Interactive physics-based graph layout simulator. Visualizes distributed consensus gossip propagation with reactive canvas dynamics.',
    type: 'animation',
    tag: '⚡ LIVE INTERACTIVE',
    tagColor: 'text-indigo-400 bg-indigo-500/20 border-indigo-500/30',
    tech: ['TypeScript', 'Canvas2D', 'Verlet Physics'],
    demoUrl: '#interactive-canvas',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'particle-mesh --nodes 48 --radius 100',
  },
  {
    title: 'Nadir Distributed KV',
    description: 'Fault-tolerant, consensus-backed key-value store with lease-based cache eviction and zero-lock reader guarantees.',
    type: 'image',
    tag: 'SCHEMATIC IMAGE',
    tagColor: 'text-amber-400 bg-amber-500/20 border-amber-500/30',
    tech: ['Raft', 'Go', 'Distributed Systems'],
    demoUrl: '/nadir',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'raft-quorum --nodes 5 --lease 300ms',
  },
  {
    title: 'Kube-Replay Trace Proxy',
    description: 'Low-latency eBPF network packet recorder reproducing production gRPC ingress traffic locally with sub-millisecond precision.',
    type: 'terminal',
    tag: 'eBPF / K8S',
    tagColor: 'text-cyan-400 bg-cyan-500/20 border-cyan-500/30',
    tech: ['Rust', 'eBPF', 'gRPC', 'Linux Kernel'],
    demoUrl: 'https://github.com/Chandra179',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'tc-bpf egress filter attached',
  },
  {
    title: 'Vortex WAL Engine',
    description: 'Append-only write ahead log with sequential zero-copy memory mapping and vectorized index scans for high-ingest time-series workloads.',
    type: 'terminal',
    tag: 'STORAGE ENGINE',
    tagColor: 'text-purple-400 bg-purple-500/20 border-purple-500/30',
    tech: ['Go', 'mmap', 'SIMD', 'LSM-Tree'],
    demoUrl: 'https://github.com/Chandra179',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'wal-sync: 1.4M ops/sec throughput',
  },
  {
    title: 'Hyperion Edge Router',
    description: 'Consistent hashing reverse proxy with distributed token-bucket rate limiters and autonomous health-check failover rings.',
    type: 'terminal',
    tag: 'NETWORKING',
    tagColor: 'text-emerald-400 bg-emerald-500/20 border-emerald-500/30',
    tech: ['Go', 'HTTP/3', 'Consistent Hashing'],
    demoUrl: 'https://github.com/Chandra179',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'quic-stream listener :443 [READY]',
  },
];

const siteName = 'Chandra';
const baseDescription = 'Software engineer focusing on distributed systems, Go, developer infrastructure, and minimal web experiences.';

const homepageJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://chan179.com/#author',
    name: 'Chandra',
    url: 'https://chan179.com',
    sameAs: [
      'https://github.com/Chandra179',
      'https://x.com/chandra179',
      'https://www.linkedin.com/in/chandraa17/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: 'https://chan179.com',
  },
];
---

<BaseLayout
  title={siteName}
  description={baseDescription}
  canonical="/"
  noNav={true}
  jsonLd={homepageJsonLd}
>
  <!-- FLOATING THEME TOGGLE (NO NAVBAR) -->
  <aside class="fixed top-6 right-6 z-50 flex items-center gap-3">
    <button
      @click="isDark = !isDark; document.documentElement.classList.toggle('dark', isDark); localStorage.setItem('darkMode', isDark)"
      class="p-2.5 rounded-full bg-zinc-100/80 dark:bg-zinc-900/80 backdrop-blur-md border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white shadow-sm hover:scale-105 transition-all duration-200 cursor-pointer"
      aria-label="Toggle dark mode"
      title="Toggle theme (Light / Dark)"
    >
      <!-- Sun Icon (shown in dark mode) -->
      <svg x-show="isDark" class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
      </svg>
      <!-- Moon Icon (shown in light mode) -->
      <svg x-show="!isDark" class="w-4 h-4 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
    </button>
  </aside>

  <!-- MAIN WRAPPER WITH DYNAMIC GRID RESPONSIVENESS -->
  <main
    x-data={`{
      projectCols: 2,
      projectPage: 1,
      projectPageSize: 4,
      totalProjects: ${projects.length},
      get totalProjectPages() {
        if (this.projectPageSize === 'all') return 1;
        return Math.ceil(this.totalProjects / this.projectPageSize);
      },
      isProjectVisible(idx) {
        if (this.projectPageSize === 'all') return true;
        const start = (this.projectPage - 1) * this.projectPageSize;
        return idx >= start && idx < (start + this.projectPageSize);
      },
      get projectStartIdx() {
        if (this.totalProjects === 0) return 0;
        return (this.projectPage - 1) * (this.projectPageSize === 'all' ? this.totalProjects : this.projectPageSize) + 1;
      },
      get projectEndIdx() {
        if (this.projectPageSize === 'all') return this.totalProjects;
        return Math.min(this.projectPage * this.projectPageSize, this.totalProjects);
      },
      setProjectCols(c) {
        this.projectCols = c;
      },
      setProjectPageSize(s) {
        this.projectPageSize = s;
        this.projectPage = 1;
      },
      goToProjectPage(p) {
        if (p >= 1 && p <= this.totalProjectPages) this.projectPage = p;
      },

      writingPage: 1,
      writingPageSize: 5,
      totalPosts: ${posts.length},
      get totalWritingPages() {
        if (this.writingPageSize === 'all') return 1;
        return Math.ceil(this.totalPosts / this.writingPageSize);
      },
      isWritingVisible(idx) {
        if (this.writingPageSize === 'all') return true;
        const start = (this.writingPage - 1) * this.writingPageSize;
        return idx >= start && idx < (start + this.writingPageSize);
      },
      get writingStartIdx() {
        if (this.totalPosts === 0) return 0;
        return (this.writingPage - 1) * (this.writingPageSize === 'all' ? this.totalPosts : this.writingPageSize) + 1;
      },
      get writingEndIdx() {
        if (this.writingPageSize === 'all') return this.totalPosts;
        return Math.min(this.writingPage * this.writingPageSize, this.totalPosts);
      },
      setWritingPageSize(s) {
        this.writingPageSize = s;
        this.writingPage = 1;
      },
      goToWritingPage(p) {
        if (p >= 1 && p <= this.totalWritingPages) this.writingPage = p;
      }
    }`}
    :class="projectCols === 2 ? 'max-w-5xl' : (projectCols === 3 ? 'max-w-6xl' : 'max-w-7xl')"
    class="mx-auto px-6 py-20 lg:py-24 transition-all duration-300"
  >

    <!-- HERO / IDENTITY -->
    <header class="mb-20 max-w-3xl">

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-4">
        Chandra
      </h1>

      <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-xl mb-6 font-light">
        Software engineer focusing on distributed systems, Go, developer infrastructure, and minimal web experiences.
      </p>

      <!-- SOCIAL & CONTACT LINKS -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-mono text-zinc-500 dark:text-zinc-400">
        <a href="https://github.com/Chandra179" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1 group">
          <span>github</span>
          <span class="text-zinc-400 dark:text-zinc-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
        </a>
        <span class="text-zinc-300 dark:text-zinc-700">/</span>
        <a href="https://www.linkedin.com/in/chandraa17/" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1 group">
          <span>linkedin</span>
          <span class="text-zinc-400 dark:text-zinc-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
        </a>
        <span class="text-zinc-300 dark:text-zinc-700">/</span>
        <a href="mailto:hello@chan179.com" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1 group">
          <span>email</span>
          <span class="text-zinc-400 dark:text-zinc-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
        </a>
      </div>
    </header>

    <!-- SECTION: FEATURED WORK (TERMINAL MEDIA SHOWCASE WITH GRID FILTER & PAGINATION) -->
    <section id="projects-section" class="mb-24 scroll-mt-20">
      
      <!-- Section Header with Grid Column Filter (No pagination on top) -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-200 dark:border-zinc-800 pb-4 mb-8">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-medium">
              Projects
            </h2>
          </div>
          <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-1 font-mono">
            Live demos, WebAssembly engines, and distributed architectures
          </p>
        </div>

        <!-- Grid Column Filter Switcher (2 Col, 3 Col, max 4 Col) -->
        <div class="flex items-center gap-1.5 p-1 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-[11px] font-mono text-zinc-400 px-2 select-none">Grid:</span>
          
          <!-- 2 Columns Button -->
          <button
            type="button"
            @click="setProjectCols(2)"
            :class="projectCols === 2 ? 'bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 shadow-sm border border-zinc-200 dark:border-zinc-700' : 'text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 border border-transparent'"
            class="flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-mono font-medium transition cursor-pointer"
            title="Display 2 Columns"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
              <rect x="2" y="2" width="5" height="12" rx="1.5"/>
              <rect x="9" y="2" width="5" height="12" rx="1.5"/>
            </svg>
            <span>2 Col</span>
          </button>

          <!-- 3 Columns Button -->
          <button
            type="button"
            @click="setProjectCols(3)"
            :class="projectCols === 3 ? 'bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 shadow-sm border border-zinc-200 dark:border-zinc-700' : 'text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 border border-transparent'"
            class="flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-mono font-medium transition cursor-pointer"
            title="Display 3 Columns"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
              <rect x="1.5" y="2" width="3.5" height="12" rx="1"/>
              <rect x="6.25" y="2" width="3.5" height="12" rx="1"/>
              <rect x="11" y="2" width="3.5" height="12" rx="1"/>
            </svg>
            <span>3 Col</span>
          </button>

          <!-- 4 Columns Button -->
          <button
            type="button"
            @click="setProjectCols(4)"
            :class="projectCols === 4 ? 'bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 shadow-sm border border-zinc-200 dark:border-zinc-700' : 'text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 border border-transparent'"
            class="flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-mono font-medium transition cursor-pointer"
            title="Display 4 Columns (Max)"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
              <rect x="1" y="2" width="2.7" height="12" rx="0.8"/>
              <rect x="4.7" y="2" width="2.7" height="12" rx="0.8"/>
              <rect x="8.4" y="2" width="2.7" height="12" rx="0.8"/>
              <rect x="12.1" y="2" width="2.7" height="12" rx="0.8"/>
            </svg>
            <span>4 Col</span>
          </button>
        </div>
      </div>

      <!-- DYNAMIC PROJECTS GRID -->
      <div
        :class="projectCols === 2 ? 'grid grid-cols-1 md:grid-cols-2 gap-6' : (projectCols === 3 ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5' : 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4')"
        class="transition-all duration-300"
      >
        {projects.map((project, idx) => (
          <article
            x-show={`isProjectVisible(${idx})`}
            class="group rounded-xl sm:rounded-2xl border border-zinc-200 dark:border-zinc-800/80 bg-zinc-50 dark:bg-zinc-900/30 overflow-hidden hover:border-zinc-300 dark:hover:border-zinc-700 transition duration-300 flex flex-col justify-between shadow-xs"
          >
            <div>
              <!-- Media Showcase Window Header -->
              <div class="relative aspect-[16/9] w-full bg-zinc-950 flex items-center justify-center overflow-hidden border-b border-zinc-200 dark:border-zinc-800/60 select-none">
                {project.type === 'animation' ? (
                  <>
                    <canvas id="interactive-canvas" class="absolute inset-0 w-full h-full cursor-crosshair"></canvas>
                    <div class="absolute inset-0 pointer-events-none flex flex-col justify-between p-3.5 sm:p-4 font-mono text-xs">
                      <div class="flex items-center justify-between text-zinc-400 border-b border-zinc-800/80 pb-1.5">
                        <div class="flex items-center gap-1.5">
                          <span class="h-2 w-2 rounded-full bg-red-500/80"></span>
                          <span class="h-2 w-2 rounded-full bg-yellow-500/80"></span>
                          <span class="h-2 w-2 rounded-full bg-emerald-500/80"></span>
                        </div>
                        <span class="text-[9px] font-semibold tracking-wide px-1.5 py-0.5 rounded border border-indigo-500/30 text-indigo-400 bg-indigo-500/20">
                          {project.tag}
                        </span>
                      </div>
                      <div class="flex justify-between items-center text-[9px] text-zinc-500 pt-1">
                        <span>#02</span>
                        <span class="text-indigo-400">interactive canvas ↗</span>
                      </div>
                    </div>
                  </>
                ) : project.type === 'image' ? (
                  <div class="absolute inset-0 bg-gradient-to-tr from-zinc-950 via-zinc-900 to-zinc-950 flex flex-col justify-between p-3.5 sm:p-4 font-mono text-xs">
                    <div class="flex items-center justify-between text-zinc-400 border-b border-zinc-800/80 pb-1.5">
                      <div class="flex items-center gap-1.5">
                        <span class="h-2 w-2 rounded-full bg-red-500/80"></span>
                        <span class="h-2 w-2 rounded-full bg-yellow-500/80"></span>
                        <span class="h-2 w-2 rounded-full bg-emerald-500/80"></span>
                      </div>
                      <span class="text-[9px] font-semibold tracking-wide px-1.5 py-0.5 rounded border border-amber-500/30 text-amber-400 bg-amber-500/20">
                        {project.tag}
                      </span>
                    </div>
                    <div class="my-auto py-2 text-center">
                      <div class="grid grid-cols-3 gap-1.5 text-[9px] text-zinc-300 max-w-xs mx-auto">
                        <div class="p-1.5 rounded bg-zinc-800/80 border border-zinc-700/60">Client Leases</div>
                        <div class="p-1.5 rounded bg-indigo-950/70 border border-indigo-700/60 font-bold text-indigo-300">Raft Quorum</div>
                        <div class="p-1.5 rounded bg-zinc-800/80 border border-zinc-700/60">WAL Log</div>
                      </div>
                    </div>
                    <div class="flex justify-between items-center text-[9px] text-zinc-500 pt-1">
                      <span>#03</span>
                      <span class="text-amber-400">p99: 1.2ms</span>
                    </div>
                  </div>
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-tr from-zinc-950 via-zinc-900 to-zinc-950 flex flex-col justify-between p-3.5 sm:p-4 font-mono text-xs">
                    <div class="flex items-center justify-between text-zinc-400 border-b border-zinc-800/80 pb-1.5">
                      <div class="flex items-center gap-1.5">
                        <span class="h-2 w-2 rounded-full bg-red-500/80"></span>
                        <span class="h-2 w-2 rounded-full bg-yellow-500/80"></span>
                        <span class="h-2 w-2 rounded-full bg-emerald-500/80"></span>
                      </div>
                      <span class={`text-[9px] font-semibold tracking-wide px-1.5 py-0.5 rounded border ${project.tagColor}`}>
                        {project.tag}
                      </span>
                    </div>
                    
                    <div class="my-auto text-center py-2 space-y-1">
                      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-zinc-800/70 border border-zinc-700/50 backdrop-blur-xs text-[11px] text-zinc-200">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                        <span>{project.previewSnippet}</span>
                      </div>
                    </div>

                    <div class="flex justify-between items-center text-[9px] text-zinc-500 pt-1">
                      <span>#{String(idx + 1).padStart(2, '0')}</span>
                      <span class="text-zinc-400 group-hover:text-emerald-400 transition-colors">inspect ↗</span>
                    </div>
                  </div>
                )}
              </div>

              <!-- Content Body -->
              <div class="p-5" :class="projectCols >= 4 ? 'p-4' : 'p-5'">
                <div class="flex items-start justify-between gap-2 mb-1.5">
                  <h3
                    class="text-base font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors"
                    :class="projectCols >= 4 ? 'text-sm font-semibold' : 'text-base font-semibold'"
                  >
                    {project.title}
                  </h3>
                </div>
                <p
                  class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-4 font-light leading-relaxed"
                  :class="projectCols >= 4 ? 'text-xs line-clamp-2' : 'line-clamp-3'"
                >
                  {project.description}
                </p>
              </div>
            </div>

            <!-- Footer Meta & Links -->
            <div class="p-5 pt-0" :class="projectCols >= 4 ? 'p-4 pt-0' : 'p-5 pt-0'">
              <div class="flex flex-wrap gap-1.5 text-[10px] font-mono mb-3">
                {project.tech.map((t) => (
                  <span class="px-2 py-0.5 rounded-md bg-zinc-200/70 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700/50">
                    {t}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between pt-2.5 border-t border-zinc-200/70 dark:border-zinc-800/70 text-xs font-mono">
                <div class="flex items-center gap-3">
                  {project.demoUrl && (
                    <a href={project.demoUrl} target={project.demoUrl.startsWith('http') ? '_blank' : undefined} rel={project.demoUrl.startsWith('http') ? 'noopener noreferrer' : undefined} class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition flex items-center gap-0.5">
                      <span>demo</span>
                      <span class="text-[10px]">↗</span>
                    </a>
                  )}
                  {project.githubUrl && (
                    <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition flex items-center gap-0.5">
                      <span>code</span>
                      <span class="text-[10px]">↗</span>
                    </a>
                  )}
                </div>
                <span class="text-[10px] text-zinc-400">active</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- PROJECTS PAGINATION TOOLBAR (Unified at bottom, matches Writing & Notes) -->
      <div class="mt-8 pt-4 border-t border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
        <div class="flex flex-wrap items-center gap-3">
          <div class="text-zinc-500 dark:text-zinc-400">
            Showing <span class="font-medium text-zinc-800 dark:text-zinc-200" x-text="projectStartIdx"></span>–<span class="font-medium text-zinc-800 dark:text-zinc-200" x-text="projectEndIdx"></span> of <span class="font-medium text-zinc-800 dark:text-zinc-200">{projects.length}</span> projects
          </div>
          <span class="text-zinc-300 dark:text-zinc-700">|</span>
          <div class="flex items-center gap-1 text-zinc-500">
            <span class="text-[11px] text-zinc-400">Page size:</span>
            <button
              type="button"
              @click="setProjectPageSize(2)"
              :class="projectPageSize === 2 ? 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold' : 'text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60'"
              class="px-2 py-0.5 rounded cursor-pointer transition"
            >2</button>
            <button
              type="button"
              @click="setProjectPageSize(4)"
              :class="projectPageSize === 4 ? 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold' : 'text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60'"
              class="px-2 py-0.5 rounded cursor-pointer transition"
            >4</button>
            <button
              type="button"
              @click="setProjectPageSize(6)"
              :class="projectPageSize === 6 ? 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold' : 'text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60'"
              class="px-2 py-0.5 rounded cursor-pointer transition"
            >6</button>
            <button
              type="button"
              @click="setProjectPageSize('all')"
              :class="projectPageSize === 'all' ? 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold' : 'text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60'"
              class="px-2 py-0.5 rounded cursor-pointer transition"
            >All</button>
          </div>
        </div>

        <!-- Prev / Next & Page Buttons -->
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            @click="goToProjectPage(projectPage - 1)"
            :disabled="projectPage <= 1"
            class="px-2.5 py-1 rounded-md border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed transition cursor-pointer"
          >
            ← Prev
          </button>
          
          <template x-for="p in totalProjectPages" :key="p">
            <button
              type="button"
              @click="goToProjectPage(p)"
              :class="projectPage === p ? 'bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 font-semibold' : 'border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-600 dark:text-zinc-400'"
              class="w-7 h-7 flex items-center justify-center rounded-md text-xs font-mono transition cursor-pointer"
              x-text="p"
            >
            </button>
          </template>

          <button
            type="button"
            @click="goToProjectPage(projectPage + 1)"
            :disabled="projectPage >= totalProjectPages"
            class="px-2.5 py-1 rounded-md border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed transition cursor-pointer"
          >
            Next →
          </button>
        </div>
      </div>
    </section>

    <!-- MINIMALIST FOOTER -->
    <footer class="pt-8 dark:border-zinc-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500">
      <div>
        © {new Date().getFullYear()} Chandra
      </div>
      <div class="flex items-center gap-4">
        <span>Astro + Tailwind</span>
        <span>•</span>
        <a href="/rss.xml" class="hover:text-zinc-800 dark:hover:text-zinc-300 transition">RSS</a>
      </div>
    </footer>

  </main>

  <!-- INTERACTIVE CANVAS LOGIC -->
  <script is:inline>
    (function () {
      var canvas = document.getElementById('interactive-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      if (!ctx) return;

      var width, height;
      var particles = [];
      var mouse = { x: null, y: null, radius: 100 };

      function resize() {
        if (!canvas || !canvas.parentElement) return;
        width = canvas.width = canvas.parentElement.offsetWidth;
        height = canvas.height = canvas.parentElement.offsetHeight;
        initParticles();
      }

      function Particle() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.vx = (Math.random() - 0.5) * 0.8;
        this.vy = (Math.random() - 0.5) * 0.8;
        this.radius = 2;
      }

      Particle.prototype.update = function () {
        this.x += this.vx;
        this.y += this.vy;

        if (this.x < 0 || this.x > width) this.vx *= -1;
        if (this.y < 0 || this.y > height) this.vy *= -1;

        if (mouse.x !== null && mouse.y !== null) {
          var dx = mouse.x - this.x;
          var dy = mouse.y - this.y;
          var distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < mouse.radius) {
            var force = (mouse.radius - distance) / mouse.radius;
            this.x -= (dx / distance) * force * 3;
            this.y -= (dy / distance) * force * 3;
          }
        }
      };

      Particle.prototype.draw = function () {
        var isDark = document.documentElement.classList.contains('dark');
        ctx.fillStyle = isDark ? '#818cf8' : '#6366f1';
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();
      };

      function initParticles() {
        particles = [];
        var count = Math.floor((width * height) / 7000);
        for (var i = 0; i < count; i++) {
          particles.push(new Particle());
        }
      }

      function animate() {
        if (!ctx) return;
        ctx.clearRect(0, 0, width, height);

        var isDark = document.documentElement.classList.contains('dark');

        for (var i = 0; i < particles.length; i++) {
          for (var j = i + 1; j < particles.length; j++) {
            var dx = particles[i].x - particles[j].x;
            var dy = particles[i].y - particles[j].y;
            var dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 80) {
              ctx.strokeStyle = isDark
                ? 'rgba(129, 140, 248, ' + (0.25 * (1 - dist / 80)) + ')'
                : 'rgba(99, 102, 241, ' + (0.25 * (1 - dist / 80)) + ')';
              ctx.lineWidth = 0.8;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
            }
          }
        }

        for (var k = 0; k < particles.length; k++) {
          particles[k].update();
          particles[k].draw();
        }

        requestAnimationFrame(animate);
      }

      window.addEventListener('resize', resize);
      canvas.addEventListener('mousemove', function (e) {
        var rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });
      canvas.addEventListener('mouseleave', function () {
        mouse.x = null;
        mouse.y = null;
      });

      resize();
      animate();
    })();
  </script>
</BaseLayout>

