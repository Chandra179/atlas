---
import type { NavSection, NavPage } from '../lib/nav';

interface Props {
  nav: NavSection[];
  currentPath: string;
}

const { nav, currentPath } = Astro.props;

function isActive(url: string, current: string): boolean {
  const norm = (u: string) => u.replace(/\/$/, '') || '/';
  return norm(url) === norm(current);
}

function isCategoryActive(slug: string, current: string): boolean {
  return current.replace(/^\//, '').startsWith(slug + '/') || current === '/' + slug;
}

// Compute initial expanded state so the active section/folder is open on load.
const initialSections: Record<string, boolean> = {};
const initialFolders: Record<string, boolean> = {};
for (const section of nav) {
  if (section.standalone || !section.pages) continue;
  if (isCategoryActive(section.slug, currentPath)) {
    initialSections[section.slug] = true;
    for (const page of section.pages) {
      if (page.isFolder && page.pages) {
        const key = `${section.slug}/${page.slug}`;
        if (isActive(page.url, currentPath) ||
            page.pages.some((p) => isActive(p.url, currentPath))) {
          initialFolders[key] = true;
        }
      }
    }
  }
}
const initialState = JSON.stringify({ expandedSections: initialSections, expandedFolders: initialFolders });
---

<aside
  id="sidebar"
  class="fixed top-16 left-0 bottom-0 w-64 bg-white dark:bg-gray-900 overflow-y-auto z-40 transition-transform duration-300 -translate-x-full lg:translate-x-0"
  :class="mobileMenuOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'"
  x-data={initialState}
  x-init="setTimeout(() => { const active = $el.querySelector('[aria-current=page]'); if (active) active.scrollIntoView({ block: 'center' }); }, 100)"
>
  <div class="p-6"></div>
  <nav class="px-4 pb-6">
    {nav.map((section: NavSection) => (
      <div>
        {section.standalone ? (
          <!-- Standalone page (no dropdown) -->
          <div class="mb-6">
            <a href={section.url}
              class={`block px-3 mb-2 text-sm font-semibold tracking-wider hover:text-gray-900 ${isActive(section.url, currentPath) ? 'text-blue-600' : 'text-gray-500'}`}
              aria-current={isActive(section.url, currentPath) ? 'page' : undefined}>
              {section.name}
            </a>
          </div>
        ) : (
          <!-- Category with pages -->
          <div class="mb-6">
            <div class="flex items-center justify-between px-3 mb-2 group">
              <a href={section.url}
                class={`text-sm font-semibold tracking-wider hover:text-gray-900 flex-1 ${isCategoryActive(section.slug, currentPath) ? 'text-blue-600' : 'text-gray-500'}`}>
                {section.name}
              </a>
              {section.pages && section.pages.length > 0 && (
                <svg @click={`expandedSections['${section.slug}'] = !expandedSections['${section.slug}']`}
                  class="w-4 h-4 text-gray-400 transition-transform duration-200 cursor-pointer hover:text-gray-600"
                  :class={`expandedSections['${section.slug}'] ? 'rotate-180' : ''`}
                  fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              )}
            </div>

            {section.pages && (
              <div x-show={`expandedSections['${section.slug}']`}
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 transform -translate-y-2"
                x-transition:enter-end="opacity-100 transform translate-y-0"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 transform translate-y-0"
                x-transition:leave-end="opacity-0 transform -translate-y-2">
                {section.pages.map((page: NavPage) => (
                  <div>
                    {!page.isFolder ? (
                      <!-- Regular page -->
                      <a href={page.url}
                        class={`nav-link block px-6 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 mb-1 ${isActive(page.url, currentPath) ? 'active' : ''}`}
                        aria-current={isActive(page.url, currentPath) ? 'page' : undefined}>
                        {page.name}
                      </a>
                    ) : (
                      <!-- Nested folder -->
                      <div class="mb-1">
                        <div class="flex items-center justify-between px-6 py-2 rounded-lg hover:bg-gray-50">
                          <a href={page.url}
                            class={`flex-1 text-sm font-medium cursor-pointer ${isActive(page.url, currentPath) ? 'text-blue-600' : 'text-gray-700'}`}
                            aria-current={isActive(page.url, currentPath) ? 'page' : undefined}>
                            {page.name}
                          </a>
                          <svg @click={`expandedFolders['${section.slug}/${page.slug}'] = !expandedFolders['${section.slug}/${page.slug}']`}
                            class="w-3 h-3 text-gray-400 transition-transform duration-200 cursor-pointer hover:text-gray-600"
                            :class={`expandedFolders['${section.slug}/${page.slug}'] ? 'rotate-180' : ''`}
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                          </svg>
                        </div>
                        {page.pages && (
                          <div x-show={`expandedFolders['${section.slug}/${page.slug}']`}
                            x-transition:enter="transition ease-out duration-200"
                            x-transition:enter-start="opacity-0 transform -translate-y-2"
                            x-transition:enter-end="opacity-100 transform translate-y-0"
                            x-transition:leave="transition ease-in duration-150"
                            x-transition:leave-start="opacity-100 transform translate-y-0"
                            x-transition:leave-end="opacity-0 transform -translate-y-2"
                            class="ml-4">
                            {page.pages.map((subpage: NavPage) => (
                              <a href={subpage.url}
                                class={`nav-link block px-6 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50 mb-1 ${isActive(subpage.url, currentPath) ? 'active' : ''}`}
                                aria-current={isActive(subpage.url, currentPath) ? 'page' : undefined}>
                                {subpage.name}
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    ))}
  </nav>
</aside>
