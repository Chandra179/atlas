---
import { render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import { buildNav, deriveTitle, entryIdToUrl, type NavSection, type NavPage } from '../lib/nav';
import { getValidEntries } from '../lib/entries';

const RELATED_POSTS_LIMIT = 3;

function findRelatedPosts(
  entry: Awaited<ReturnType<typeof getValidEntries>>[number],
  allEntries: Awaited<ReturnType<typeof getValidEntries>>
) {
  const tags = entry.data.tags || [];
  if (tags.length === 0) return [];

  const scored = allEntries
    .filter((e) => e.id !== entry.id && !e.data.noindex)
    .map((e) => {
      const sharedTags = (e.data.tags || []).filter((t) => tags.includes(t));
      return { entry: e, shared: sharedTags.length };
    })
    .filter((r) => r.shared > 0)
    .sort((a, b) => {
      if (b.shared !== a.shared) return b.shared - a.shared;
      const aDate = a.entry.data.created?.getTime() ?? 0;
      const bDate = b.entry.data.created?.getTime() ?? 0;
      return bDate - aDate;
    })
    .slice(0, RELATED_POSTS_LIMIT);

  return scored.map(({ entry: e }) => {
    const slug = e.id.split('/').pop()!;
    return { title: e.data.title || deriveTitle(slug, e.data.title), url: entryIdToUrl(e.id) };
  });
}

export async function getStaticPaths() {
  const validEntries = await getValidEntries();

  const entryMap: Record<string, typeof validEntries[number]> = {};
  for (const entry of validEntries) {
    entryMap[entry.id] = entry;
  }

  const nav = buildNav(validEntries);
  const paths = [];

  // Generate paths for actual content entries
  for (const entry of validEntries) {
    let url = entry.id;
    url = url.replace(/\/readme$/i, '');
    if (url.toLowerCase() === 'readme') continue;
    paths.push({
      params: { slug: url },
      props: { entryId: entry.id, nav, entryMap, isIndex: false, indexTitle: '', indexPages: [] as NavPage[] },
    });
  }

  // Generate category/folder index pages for dirs without READMEs
  for (const section of nav) {
    if (section.standalone) continue;
    if (!section.entryId) {
      paths.push({
        params: { slug: section.url.replace(/^\//, '') },
        props: { entryId: null, nav, entryMap, isIndex: true, indexTitle: section.name, indexPages: section.pages || [] },
      });
    }
    if (section.pages) {
      for (const page of section.pages) {
        if (page.isFolder && !page.entryId) {
          paths.push({
            params: { slug: page.url.replace(/^\//, '') },
            props: { entryId: null, nav, entryMap, isIndex: true, indexTitle: page.name, indexPages: page.pages || [] },
          });
        }
      }
    }
  }

  return paths;
}

const { entryId, nav, entryMap, isIndex, indexTitle, indexPages } = Astro.props;
const currentUrl = '/' + (Astro.params.slug || '');

// For content pages, fetch and render the entry
let Content: any = null;
let headings: { depth: number; slug: string; text: string }[] = [];
let title = indexTitle;
let description: string | undefined;
let body = '';
let created: Date | undefined;
let modified: Date | undefined;
let tags: string[] = [];
let ogImage: string | undefined;
let author: string | undefined;
let entryNoindex = false;
let relatedPosts: { title: string; url: string }[] = [];

if (!isIndex && entryId) {
  const entry = entryMap[entryId];
  if (!entry) {
    return Astro.redirect('/404');
  }
  const rendered = await render(entry);
  Content = rendered.Content;
  headings = rendered.headings;
  const slug = currentUrl.split('/').pop() || currentUrl;
  title = entry.data.title || deriveTitle(slug, entry.data.title);
  description = entry.data.description;
  body = entry.body;
  created = entry.data.created;
  modified = entry.data.modified;
  tags = entry.data.tags || [];
  ogImage = (entry.data as any).ogImage;
  author = entry.data.author;
  entryNoindex = entry.data.noindex ?? false;
  relatedPosts = findRelatedPosts(entry, Object.values(entryMap));
}

if (isIndex) {
  description = `Browse articles about ${indexTitle}. Personal blog on software engineering, system design`;
}
---

<DocLayout
  title={title}
  description={description}
  ogImage={ogImage}
  body={body}
  headings={headings}
  url={currentUrl}
  nav={nav}
  created={created}
  modified={modified}
  tags={tags}
  author={author}
  noindex={isIndex || entryNoindex}
  relatedPosts={relatedPosts}
>
  {isIndex ? (
    <>
      <h1>{indexTitle}</h1>
      <ul class="category-index-list">
        {indexPages.map((page: NavPage) => (
          <li>
            <a href={page.url} class="category-index-link">
              <strong>{page.name}</strong>
            </a>
            {page.isFolder && page.pages && page.pages.length > 0 && (
              <ul class="category-index-sublist">
                {page.pages.map((subpage: NavPage) => (
                  <li>
                    <a href={subpage.url}>{subpage.name}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </>
  ) : (
    Content && <Content />
  )}
</DocLayout>
