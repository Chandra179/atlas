                {projects[1].title}
              </h3>
              <div class="flex items-center gap-3 text-xs font-mono">
                {projects[1].demoUrl && (
                  <a href={projects[1].demoUrl} class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition flex items-center gap-1">demo ↗</a>
                )}
