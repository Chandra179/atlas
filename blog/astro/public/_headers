# Cloudflare Pages cache headers

# Security headers + default HTML caching (applied to all responses).
# Clean URLs (e.g. /introduction) never match a /*.html pattern, so the
# default Cache-Control lives here and gets overridden below by the
# more specific rules for hashed assets, images, etc.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=21600, stale-while-revalidate=86400

# Sitemap: 1 day, SWR 1 week
/sitemap-index.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# JS/CSS/WebFont with hash: 1 year (immutable)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images: 1 day, SWR 1 week
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.woff2
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Pagefind index: 1 day
/pagefind/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
