---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getValidEntries } from '../lib/entries';
import { entryIdToUrl, deriveTitle } from '../lib/nav';
import { extractDescription } from '../lib/description';

const validEntries = await getValidEntries();

// Sort entries by created date (newest first)
const posts = validEntries
  .filter((e) => !e.data.noindex && e.id.toLowerCase() !== 'readme')
  .map((e) => {
    const slug = e.id.split('/').pop() || e.id;
    const title = e.data.title || deriveTitle(slug, e.data.title);
    const url = entryIdToUrl(e.id);
    const date = e.data.created ? new Date(e.data.created) : undefined;
    const formattedDate = date
      ? `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`
      : '';
    const tag = e.data.tags && e.data.tags.length > 0 ? e.data.tags[0] : 'note';
    const wordCount = e.body ? e.body.split(/\s+/).filter(Boolean).length : 0;
    const readTime = Math.max(1, Math.round(wordCount / 200)) + ' min read';

    return {
      title,
      url,
      date,
      formattedDate,
      tag,
      readTime,
      description: e.data.description || extractDescription(e.body),
    };
  })
  .sort((a, b) => {
    const aTime = a.date ? a.date.getTime() : 0;
    const bTime = b.date ? b.date.getTime() : 0;
    return bTime - aTime;
  });

const projects = [
  {
    title: 'Atlas Telemetry Canvas',
    description: 'High-throughput terminal rendering pipeline built with WebGPU and Go WebAssembly. Zero-overhead frame streaming for real-time cluster observability.',
    type: 'video',
    tag: '● VIDEO DEMO',
    tech: ['Go', 'WebAssembly', 'WebGPU', 'Video/MP4'],
    demoUrl: 'https://github.com/Chandra179/atlas',
    githubUrl: 'https://github.com/Chandra179/atlas',
  },
  {
    title: 'Synapse Node Mesh',
    description: 'Interactive physics-based graph layout simulator. Visualizes distributed consensus gossip propagation with reactive canvas dynamics.',
    type: 'animation',
    tag: '⚡ LIVE INTERACTIVE',
    tech: ['TypeScript', 'Canvas2D', 'Verlet Physics'],
    demoUrl: '#interactive-canvas',
    githubUrl: 'https://github.com/Chandra179',
  },
  {
    title: 'Nadir Distributed KV',
    description: 'Fault-tolerant, consensus-backed key-value store with lease-based cache eviction and zero-lock reader guarantees.',
    type: 'image',
    tag: 'SCHEMATIC IMAGE',
    tech: ['Raft', 'Go', 'Distributed Systems'],
    demoUrl: '/nadir',
    githubUrl: 'https://github.com/Chandra179',
  },
];

const siteName = 'Chandra';
const baseDescription = 'Software engineer focusing on distributed systems, Go, developer infrastructure, and minimal web experiences.';

const homepageJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://chan179.com/#author',
    name: 'Chandra',
    url: 'https://chan179.com',
    sameAs: [
      'https://github.com/Chandra179',
      'https://x.com/chandra179',
      'https://www.linkedin.com/in/chandraa17/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: 'https://chan179.com',
  },
];
---

<BaseLayout
  title={siteName}
  description={baseDescription}
  canonical="/"
  noNav={true}
  jsonLd={homepageJsonLd}
>
  <!-- FLOATING THEME TOGGLE (NO NAVBAR) -->
  <aside class="fixed top-6 right-6 z-50 flex items-center gap-3">
    <button
      @click="isDark = !isDark; document.documentElement.classList.toggle('dark', isDark); localStorage.setItem('darkMode', isDark)"
      class="p-2.5 rounded-full bg-zinc-100/80 dark:bg-zinc-900/80 backdrop-blur-md border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white shadow-sm hover:scale-105 transition-all duration-200 cursor-pointer"
      aria-label="Toggle dark mode"
      title="Toggle theme (Light / Dark)"
    >
      <!-- Sun Icon (shown in dark mode) -->
      <svg x-show="isDark" class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
      </svg>
      <!-- Moon Icon (shown in light mode) -->
      <svg x-show="!isDark" class="w-4 h-4 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
    </button>
  </aside>

