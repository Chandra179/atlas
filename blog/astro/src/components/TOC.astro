---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Group h3 under preceding h2 for nesting
const tocTree: Array<{ slug: string; text: string; children: { slug: string; text: string }[] }> = [];
let currentH2: (typeof tocTree)[number] | null = null;
for (const h of tocHeadings) {
  if (h.depth === 2) {
    currentH2 = { slug: h.slug, text: h.text, children: [] };
    tocTree.push(currentH2);
  } else if (h.depth === 3 && currentH2) {
    currentH2.children.push({ slug: h.slug, text: h.text });
  }
}

const hasToc = tocTree.length > 0;
---

<aside id="toc" class="hidden xl:block fixed top-16 right-0 bottom-0 w-64 overflow-y-auto bg-white dark:bg-gray-900 pt-6 pb-6" style={hasToc ? '' : 'display:none'}>
  {hasToc && (
    <ul class="toc-list">
      {tocTree.map((h2) => (
        <li class="toc-list-item">
          <a href={`#${h2.slug}`} class="toc-link">{h2.text}</a>
          {h2.children.length > 0 && (
            <ul class="toc-list">
              {h2.children.map((h3) => (
                <li class="toc-list-item">
                  <a href={`#${h3.slug}`} class="toc-link">{h3.text}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )}
</aside>

<script is:inline>
  // Runs on initial load and after every client-side transition — this
  // script's content is identical across pages, so Astro won't re-execute
  // the tag itself on navigation; the astro:page-load listener is what
  // re-binds behavior to each page's freshly-rendered #toc element.
  var __tocObserver = null;
  function __initToc() {
    var toc = document.getElementById('toc');
    if (__tocObserver) {
      __tocObserver.disconnect();
      __tocObserver = null;
    }
    if (!toc) return;

    // Smooth scroll on click
    toc.addEventListener('click', function (e) {
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      e.preventDefault();
      var el = document.getElementById(a.getAttribute('href').slice(1));
      if (el) {
        var top = el.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
    });

    // Active heading tracking via IntersectionObserver
    var links = toc.querySelectorAll('.toc-link');
    var headings = [];
    links.forEach(function (l) {
      var h = document.getElementById(l.getAttribute('href').slice(1));
      if (h) headings.push(h);
    });
    if (!headings.length) return;

    var activeClass = 'is-active-link';
    function clearActive() {
      toc.querySelectorAll('.' + activeClass).forEach(function (l) { l.classList.remove(activeClass); });
    }
    function setActive(link) {
      clearActive();
      if (link) link.classList.add(activeClass);
    }

    // Initial active — pick the first heading above or at the top of viewport
    function updateInitialActive() {
      var scrollY = window.scrollY;
      for (var i = headings.length - 1; i >= 0; i--) {
        var rect = headings[i].getBoundingClientRect();
        var top = rect.top + window.scrollY;
        if (top <= scrollY + 100) {
          var link = toc.querySelector('a[href="#' + headings[i].id + '"]');
          if (link) setActive(link);
          return;
        }
      }
    }
    updateInitialActive();

    // Auto-scroll TOC so active link stays visible
    function scrollTocToLink(link) {
      var tocRect = toc.getBoundingClientRect();
      var linkRect = link.getBoundingClientRect();
      if (linkRect.top < tocRect.top + 24 || linkRect.bottom > tocRect.bottom - 24) {
        link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    __tocObserver = new IntersectionObserver(function (entries) {
      var activeFound = false;
      entries.forEach(function (entry) {
        var link = toc.querySelector('a[href="#' + entry.target.id + '"]');
        if (!link) return;
        if (entry.isIntersecting) {
          setActive(link);
          scrollTocToLink(link);
          activeFound = true;
        }
      });
      // If nothing is intersecting and we're scrolled past the last heading,
      // keep showing whatever was active — don't clear.
      if (!activeFound) return;
    }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });

    headings.forEach(function (h) { __tocObserver.observe(h); });
  }
  document.addEventListener('astro:page-load', __initToc);
</script>
