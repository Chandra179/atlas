# Cloudflare Pages cache headers
# Port of blog/src/worker.js cache TTLs

# HTML: 1 hour, stale-while-revalidate 1 day
/*.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# JSON/XML: 1 day, SWR 1 week
/search-index.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/landing-index.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sitemap-index.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# JS/CSS with hash: 1 year (immutable)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images: 1 day, SWR 1 week
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.woff2
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Pagefind index: 1 day
/pagefind/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
