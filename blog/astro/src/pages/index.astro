---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getValidEntries } from '../lib/entries';
import { entryIdToUrl, deriveTitle } from '../lib/nav';
import { extractDescription } from '../lib/description';

const validEntries = await getValidEntries();

// Sort entries by created date (newest first)
const posts = validEntries
  .filter((e) => !e.data.noindex && e.id.toLowerCase() !== 'readme')
  .map((e) => {
    const slug = e.id.split('/').pop() || e.id;
    const title = e.data.title || deriveTitle(slug, e.data.title);
    const url = entryIdToUrl(e.id);
    const date = e.data.created ? new Date(e.data.created) : undefined;
    const formattedDate = date
      ? `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`
      : '';
    const wordCount = e.body ? e.body.split(/\s+/).filter(Boolean).length : 0;
    const readTime = Math.max(1, Math.round(wordCount / 200)) + ' min read';

    return {
      title,
      url,
      date,
      formattedDate,
      readTime,
      description: e.data.summary || e.data.description || extractDescription(e.body),
      links: e.data.links,
    };
  })
  .sort((a, b) => {
    const aTime = a.date ? a.date.getTime() : 0;
    const bTime = b.date ? b.date.getTime() : 0;
    return bTime - aTime;
  });

const projects = [
  {
    title: 'Atlas Telemetry Canvas',
    description: 'High-throughput terminal rendering pipeline built with WebGPU and Go WebAssembly. Zero-overhead frame streaming for real-time cluster observability.',
    type: 'video',
    tag: '● VIDEO DEMO',
    tagColor: 'text-red-400 bg-red-500/20 border-red-500/30',
    tech: ['Go', 'WebAssembly', 'WebGPU', 'Video/MP4'],
    demoUrl: 'https://github.com/Chandra179/atlas',
    githubUrl: 'https://github.com/Chandra179/atlas',
    previewSnippet: 'atlas-engine --stream --fps 60',
  },
  {
    title: 'Synapse Node Mesh',
    description: 'Interactive physics-based graph layout simulator. Visualizes distributed consensus gossip propagation with reactive canvas dynamics.',
    type: 'animation',
    tag: '⚡ LIVE INTERACTIVE',
    tagColor: 'text-indigo-400 bg-indigo-500/20 border-indigo-500/30',
    tech: ['TypeScript', 'Canvas2D', 'Verlet Physics'],
    demoUrl: '#interactive-canvas',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'particle-mesh --nodes 48 --radius 100',
  },
  {
    title: 'Nadir Distributed KV',
    description: 'Fault-tolerant, consensus-backed key-value store with lease-based cache eviction and zero-lock reader guarantees.',
    type: 'image',
    tag: 'SCHEMATIC IMAGE',
    tagColor: 'text-amber-400 bg-amber-500/20 border-amber-500/30',
    tech: ['Raft', 'Go', 'Distributed Systems'],
    demoUrl: '/nadir',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'raft-quorum --nodes 5 --lease 300ms',
  },
  {
    title: 'Kube-Replay Trace Proxy',
    description: 'Low-latency eBPF network packet recorder reproducing production gRPC ingress traffic locally with sub-millisecond precision.',
    type: 'terminal',
    tag: 'eBPF / K8S',
    tagColor: 'text-cyan-400 bg-cyan-500/20 border-cyan-500/30',
    tech: ['Rust', 'eBPF', 'gRPC', 'Linux Kernel'],
    demoUrl: 'https://github.com/Chandra179',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'tc-bpf egress filter attached',
  },
  {
    title: 'Vortex WAL Engine',
    description: 'Append-only write ahead log with sequential zero-copy memory mapping and vectorized index scans for high-ingest time-series workloads.',
    type: 'terminal',
    tag: 'STORAGE ENGINE',
    tagColor: 'text-purple-400 bg-purple-500/20 border-purple-500/30',
    tech: ['Go', 'mmap', 'SIMD', 'LSM-Tree'],
    demoUrl: 'https://github.com/Chandra179',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'wal-sync: 1.4M ops/sec throughput',
  },
  {
    title: 'Hyperion Edge Router',
    description: 'Consistent hashing reverse proxy with distributed token-bucket rate limiters and autonomous health-check failover rings.',
    type: 'terminal',
    tag: 'NETWORKING',
    tagColor: 'text-emerald-400 bg-emerald-500/20 border-emerald-500/30',
    tech: ['Go', 'HTTP/3', 'Consistent Hashing'],
    demoUrl: 'https://github.com/Chandra179',
    githubUrl: 'https://github.com/Chandra179',
    previewSnippet: 'quic-stream listener :443 [READY]',
  },
];

const siteName = 'Chandra179';
const baseDescription = 'Interested in Data pipeline, Golang and Rust';

const homepageJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://chan179.com/#author',
    name: 'Chandra179',
    url: 'https://chan179.com',
    sameAs: [
      'https://github.com/Chandra179',
      'https://x.com/chandra179',
      'https://www.linkedin.com/in/chandraa17/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: 'https://chan179.com',
  },
];
---

<BaseLayout
  title={siteName}
  description={baseDescription}
  canonical="/"
  noNav={true}
  jsonLd={homepageJsonLd}
>
  <!-- FLOATING THEME TOGGLE (NO NAVBAR) -->
  <aside class="fixed top-6 right-6 z-50 flex items-center gap-3">
    <button
      @click="isDark = setTheme(!isDark)"
      class="p-2.5 rounded-full bg-zinc-100/80 dark:bg-zinc-900/80 backdrop-blur-md border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white shadow-sm transition-colors duration-200 cursor-pointer"
      type="button"
      aria-label="Toggle color theme"
      :aria-pressed="isDark"
      title="Toggle theme (Light / Dark)"
    >
      <!-- Sun Icon (shown in dark mode) -->
      <svg x-show="isDark" aria-hidden="true" class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
      </svg>
      <!-- Moon Icon (shown in light mode) -->
      <svg x-show="!isDark" aria-hidden="true" class="w-4 h-4 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
      </svg>
    </button>
  </aside>

  <!-- MAIN WRAPPER WITH DYNAMIC GRID RESPONSIVENESS -->
  <main
    x-data={`{
      projectCols: 2,
      projectPage: 1,
      projectPageSize: 4,
      totalProjects: ${projects.length},
      get totalProjectPages() {
        if (this.projectPageSize === 'all') return 1;
        return Math.ceil(this.totalProjects / this.projectPageSize);
      },
      isProjectVisible(idx) {
        if (this.projectPageSize === 'all') return true;
        const start = (this.projectPage - 1) * this.projectPageSize;
        return idx >= start && idx < (start + this.projectPageSize);
      },
      get projectStartIdx() {
        if (this.totalProjects === 0) return 0;
        return (this.projectPage - 1) * (this.projectPageSize === 'all' ? this.totalProjects : this.projectPageSize) + 1;
      },
      get projectEndIdx() {
        if (this.projectPageSize === 'all') return this.totalProjects;
        return Math.min(this.projectPage * this.projectPageSize, this.totalProjects);
      },
      setProjectCols(c) {
        this.projectCols = c;
      },
      setProjectPageSize(s) {
        this.projectPageSize = s;
        this.projectPage = 1;
      },
      goToProjectPage(p) {
        if (p >= 1 && p <= this.totalProjectPages) this.projectPage = p;
      },

      writingPage: 1,
      writingPageSize: 5,
      totalPosts: ${posts.length},
      get totalWritingPages() {
        if (this.writingPageSize === 'all') return 1;
        return Math.ceil(this.totalPosts / this.writingPageSize);
      },
      isWritingVisible(idx) {
        if (this.writingPageSize === 'all') return true;
        const start = (this.writingPage - 1) * this.writingPageSize;
        return idx >= start && idx < (start + this.writingPageSize);
      },
      get writingStartIdx() {
        if (this.totalPosts === 0) return 0;
        return (this.writingPage - 1) * (this.writingPageSize === 'all' ? this.totalPosts : this.writingPageSize) + 1;
      },
      get writingEndIdx() {
        if (this.writingPageSize === 'all') return this.totalPosts;
        return Math.min(this.writingPage * this.writingPageSize, this.totalPosts);
      },
      setWritingPageSize(s) {
        this.writingPageSize = s;
        this.writingPage = 1;
      },
      goToWritingPage(p) {
        if (p >= 1 && p <= this.totalWritingPages) this.writingPage = p;
      }
    }`}
    :class="projectCols === 2 ? 'max-w-5xl' : (projectCols === 3 ? 'max-w-6xl' : 'max-w-7xl')"
    class="mx-auto px-6 py-20 lg:py-24 transition-all duration-300"
  >

    <!-- HERO / IDENTITY -->
    <header class="mb-20 max-w-3xl">

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-4">
        Chandra179
      </h1>

      <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-xl mb-6 font-light">
        Im specialize in golang, javascript, optimization & data processing.
      </p>

      <!-- SOCIAL & CONTACT LINKS -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-mono text-zinc-500 dark:text-zinc-400">
        <a href="https://github.com/Chandra179" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1 group">
          <span>github</span>
          <span class="text-zinc-400 dark:text-zinc-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
        </a>
        <span class="text-zinc-300 dark:text-zinc-700">/</span>
        <a href="https://www.linkedin.com/in/chandraa17/" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1 group">
          <span>linkedin</span>
          <span class="text-zinc-400 dark:text-zinc-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
        </a>
        <span class="text-zinc-300 dark:text-zinc-700">/</span>
        <a href="mailto:chandrafirst67@gmail.com" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1 group">
          <span>email</span>
          <span class="text-zinc-400 dark:text-zinc-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
        </a>
      </div>
    </header>


    <!-- SECTION: WRITING & NOTES (EDITORIAL INDEX WITHOUT TOPIC) -->
    <section id="writing-section" class="mb-30 scroll-mt-30">
      
      <!-- Editorial Column Header (Desktop) -->
      <div class="hidden sm:grid grid-cols-12 gap-4 -mx-3 px-3 py-2 text-[11px] font-mono text-zinc-400 dark:text-zinc-500 uppercase tracking-wider border-b border-zinc-200/60 dark:border-zinc-800/60">
        <div class="col-span-2">Date</div>
        <div class="col-span-7">Title & Summary</div>
        <div class="col-span-2 text-right">Read Time</div>
        <div class="col-span-1 text-right">Action</div>
      </div>

      <!-- Editorial Rows: article title/summary is the primary link; actions are external resources only. -->
      <div class="divide-y divide-zinc-200 dark:divide-zinc-800/60 border-b border-zinc-200 dark:border-zinc-800/60">
        {posts.map((post, idx) => (
          <div
            x-show={`isWritingVisible(${idx})`}
            class="group block py-4 px-3 -mx-3 rounded-xl hover:bg-zinc-100/80 dark:hover:bg-zinc-800/30 transition-all duration-200"
          >
            <!-- Desktop Layout -->
            <div class="hidden sm:grid grid-cols-12 gap-4 items-center">
              
              <!-- Date Column -->
              <div class="col-span-2 text-xs font-mono text-zinc-400 dark:text-zinc-500 flex items-center gap-2 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-300 dark:bg-zinc-700 group-hover:bg-emerald-500 transition-colors"></span>
                <span>{post.formattedDate || 'Note'}</span>
              </div>

              <!-- Title & Summary Column -->
              <div class="col-span-7 pr-4">
                <a href={post.url} class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60 rounded-sm">
                  <div class="text-sm font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                    {post.title}
                  </div>
                  {post.description && (
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 mt-0.5 font-light">
                      {post.description}
                    </p>
                  )}
                </a>
              </div>

              <!-- Read Time Column -->
              <div class="col-span-2 text-right text-xs font-mono text-zinc-400 dark:text-zinc-500 shrink-0">
                {post.readTime}
              </div>

              <!-- External Resource Actions: empty for ordinary articles. -->
              <div class="col-span-1 flex items-center justify-end gap-3 text-zinc-500 dark:text-zinc-400">
                {post.links.github && (
                  <a
                    href={post.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`View ${post.title} on GitHub`}
                    title="GitHub"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-zinc-200/70 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.83 1.23 1.83 1.23 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.46 11.46 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.65-5.48 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
                    </svg>
                  </a>
                )}
                {post.links.demo && (
                  <a
                    href={post.links.demo}
                    target={post.links.demo.startsWith('http') ? '_blank' : undefined}
                    rel={post.links.demo.startsWith('http') ? 'noopener noreferrer' : undefined}
                    aria-label={`Open ${post.title} demo`}
                    title="Demo"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-zinc-200/70 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" />
                      <path d="m10 8 5.5 4-5.5 4V8Z" fill="currentColor" stroke="none" />
                    </svg>
                  </a>
                )}
                {post.links.documentation && (
                  <a
                    href={post.links.documentation}
                    target={post.links.documentation.startsWith('http') ? '_blank' : undefined}
                    rel={post.links.documentation.startsWith('http') ? 'noopener noreferrer' : undefined}
                    aria-label={`Read ${post.title} documentation`}
                    title="Documentation"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-zinc-200/70 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M6 3.75A2.25 2.25 0 0 1 8.25 1.5H18v18H8.25A2.25 2.25 0 0 0 6 21.75v-18Z" />
                      <path d="M6 3.75A2.25 2.25 0 0 1 8.25 1.5H18v18H8.25A2.25 2.25 0 0 0 6 21.75m0-18v18M9.5 6h5M9.5 9h5" />
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <!-- Mobile Layout -->
            <div class="sm:hidden flex flex-col gap-1.5">
              <div class="flex items-center justify-between text-xs font-mono text-zinc-400 dark:text-zinc-500">
                <span>{post.formattedDate || 'Note'}</span>
                <span>{post.readTime}</span>
              </div>
              <a href={post.url} class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60 rounded-sm">
                <div class="text-sm font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  {post.title}
                </div>
                {post.description && (
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 font-light">
                    {post.description}
                  </p>
                )}
              </a>
              {(post.links.github || post.links.demo || post.links.documentation) && (
                <div class="flex items-center justify-end gap-3 pt-0.5 text-zinc-500 dark:text-zinc-400">
                  {post.links.github && (
                    <a href={post.links.github} target="_blank" rel="noopener noreferrer" aria-label={`View ${post.title} on GitHub`} title="GitHub" class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-zinc-200/70 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60">
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.83 1.23 1.83 1.23 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.46 11.46 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.65-5.48 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" /></svg>
                    </a>
                  )}
                  {post.links.demo && (
                    <a href={post.links.demo} target={post.links.demo.startsWith('http') ? '_blank' : undefined} rel={post.links.demo.startsWith('http') ? 'noopener noreferrer' : undefined} aria-label={`Open ${post.title} demo`} title="Demo" class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-zinc-200/70 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60">
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m10 8 5.5 4-5.5 4V8Z" fill="currentColor" stroke="none" /></svg>
                    </a>
                  )}
                  {post.links.documentation && (
                    <a href={post.links.documentation} target={post.links.documentation.startsWith('http') ? '_blank' : undefined} rel={post.links.documentation.startsWith('http') ? 'noopener noreferrer' : undefined} aria-label={`Read ${post.title} documentation`} title="Documentation" class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-zinc-200/70 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60">
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3.75A2.25 2.25 0 0 1 8.25 1.5H18v18H8.25A2.25 2.25 0 0 0 6 21.75v-18Z" /><path d="M6 3.75A2.25 2.25 0 0 1 8.25 1.5H18v18H8.25A2.25 2.25 0 0 0 6 21.75m0-18v18M9.5 6h5M9.5 9h5" /></svg>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- WRITING PAGINATION TOOLBAR (Matches Selected Projects bottom toolbar) -->
      <div class="mt-6 pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
        <div class="flex flex-wrap items-center gap-3">
          <div class="text-zinc-500 dark:text-zinc-400">
            Showing <span class="font-medium text-zinc-800 dark:text-zinc-200" x-text="writingStartIdx"></span>–<span class="font-medium text-zinc-800 dark:text-zinc-200" x-text="writingEndIdx"></span> of <span class="font-medium text-zinc-800 dark:text-zinc-200">{posts.length}</span> articles
          </div>
          <span class="text-zinc-300 dark:text-zinc-700">|</span>
          <div class="flex items-center gap-1 text-zinc-500">
            <span class="text-[11px] text-zinc-400">Page size:</span>
            <button
              type="button"
              @click="setWritingPageSize(2)"
              :class="writingPageSize === 2 ? 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold' : 'text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60'"
              class="px-2 py-0.5 rounded cursor-pointer transition"
            >2</button>
            <button
              type="button"
              @click="setWritingPageSize(3)"
              :class="writingPageSize === 3 ? 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold' : 'text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60'"
              class="px-2 py-0.5 rounded cursor-pointer transition"
            >3</button>
            <button
              type="button"
              @click="setWritingPageSize(5)"
              :class="writingPageSize === 5 ? 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold' : 'text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60'"
              class="px-2 py-0.5 rounded cursor-pointer transition"
            >5</button>
            <button
              type="button"
              @click="setWritingPageSize('all')"
              :class="writingPageSize === 'all' ? 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold' : 'text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60'"
              class="px-2 py-0.5 rounded cursor-pointer transition"
            >All</button>
          </div>
        </div>

        <!-- Prev / Next & Page Buttons -->
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            @click="goToWritingPage(writingPage - 1)"
            :disabled="writingPage <= 1"
            class="px-2.5 py-1 rounded-md border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed transition cursor-pointer"
          >
            ← Prev
          </button>
          
          <template x-for="p in totalWritingPages" :key="p">
            <button
              type="button"
              @click="goToWritingPage(p)"
              :class="writingPage === p ? 'bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 font-semibold' : 'border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-600 dark:text-zinc-400'"
              class="w-7 h-7 flex items-center justify-center rounded-md text-xs font-mono transition cursor-pointer"
              x-text="p"
            >
            </button>
          </template>

          <button
            type="button"
            @click="goToWritingPage(writingPage + 1)"
            :disabled="writingPage >= totalWritingPages"
            class="px-2.5 py-1 rounded-md border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed transition cursor-pointer"
          >
            Next →
          </button>
        </div>
      </div>
    </section>

    <!-- MINIMALIST FOOTER -->
    <footer class="pt-8 border-t border-zinc-200 dark:border-zinc-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500">
      <div>
        © {new Date().getFullYear()} Chandra179
      </div>
      <div class="flex items-center gap-4">
        <span>Astro + Tailwind</span>
        <span>•</span>
        <a href="/rss.xml" class="hover:text-zinc-800 dark:hover:text-zinc-300 transition">RSS</a>
      </div>
    </footer>

  </main>

  <!-- INTERACTIVE CANVAS LOGIC -->
  <script is:inline>
    (function () {
      var canvas = document.getElementById('interactive-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      if (!ctx) return;

      var width, height;
      var particles = [];
      var mouse = { x: null, y: null, radius: 100 };

      function resize() {
        if (!canvas || !canvas.parentElement) return;
        width = canvas.width = canvas.parentElement.offsetWidth;
        height = canvas.height = canvas.parentElement.offsetHeight;
        initParticles();
      }

      function Particle() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.vx = (Math.random() - 0.5) * 0.8;
        this.vy = (Math.random() - 0.5) * 0.8;
        this.radius = 2;
      }

      Particle.prototype.update = function () {
        this.x += this.vx;
        this.y += this.vy;

        if (this.x < 0 || this.x > width) this.vx *= -1;
        if (this.y < 0 || this.y > height) this.vy *= -1;

        if (mouse.x !== null && mouse.y !== null) {
          var dx = mouse.x - this.x;
          var dy = mouse.y - this.y;
          var distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < mouse.radius) {
            var force = (mouse.radius - distance) / mouse.radius;
            this.x -= (dx / distance) * force * 3;
            this.y -= (dy / distance) * force * 3;
          }
        }
      };

      Particle.prototype.draw = function () {
        var isDark = document.documentElement.classList.contains('dark');
        ctx.fillStyle = isDark ? '#818cf8' : '#6366f1';
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();
      };

      function initParticles() {
        particles = [];
        var count = Math.floor((width * height) / 7000);
        for (var i = 0; i < count; i++) {
          particles.push(new Particle());
        }
      }

      function animate() {
        if (!ctx) return;
        ctx.clearRect(0, 0, width, height);

        var isDark = document.documentElement.classList.contains('dark');

        for (var i = 0; i < particles.length; i++) {
          for (var j = i + 1; j < particles.length; j++) {
            var dx = particles[i].x - particles[j].x;
            var dy = particles[i].y - particles[j].y;
            var dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 80) {
              ctx.strokeStyle = isDark
                ? 'rgba(129, 140, 248, ' + (0.25 * (1 - dist / 80)) + ')'
                : 'rgba(99, 102, 241, ' + (0.25 * (1 - dist / 80)) + ')';
              ctx.lineWidth = 0.8;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
            }
          }
        }

        for (var k = 0; k < particles.length; k++) {
          particles[k].update();
          particles[k].draw();
        }

        requestAnimationFrame(animate);
      }

      window.addEventListener('resize', resize);
      canvas.addEventListener('mousemove', function (e) {
        var rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });
      canvas.addEventListener('mouseleave', function () {
        mouse.x = null;
        mouse.y = null;
      });

      resize();
      animate();
    })();
  </script>
</BaseLayout>
