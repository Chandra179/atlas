        </a>
        <span class="text-zinc-300 dark:text-zinc-700">/</span>
        <a href="https://x.com/chandra179" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1 group">
